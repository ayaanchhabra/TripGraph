<mxfile host="app.diagrams.net"><diagram name="TripGraph ER" id="tripgraph-er"><mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" page="1" pageWidth="1600" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;div align='center'&gt;&lt;b&gt;category&lt;/b&gt;&lt;/div&gt;&lt;hr size='1'&gt;&lt;u&gt;category_id&lt;/u&gt; &lt;i&gt;PK&lt;/i&gt;&lt;br&gt;name&lt;br&gt;group_name&lt;br&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=8;verticalAlign=top;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="40" width="210" height="94" as="geometry"/></mxCell><mxCell id="c3" value="&lt;div align='center'&gt;&lt;b&gt;tag&lt;/b&gt;&lt;/div&gt;&lt;hr size='1'&gt;&lt;u&gt;tag_id&lt;/u&gt; &lt;i&gt;PK&lt;/i&gt;&lt;br&gt;name&lt;br&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=8;verticalAlign=top;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="230" width="210" height="76" as="geometry"/></mxCell><mxCell id="c4" value="&lt;div align='center'&gt;&lt;b&gt;place&lt;/b&gt;&lt;/div&gt;&lt;hr size='1'&gt;&lt;u&gt;place_id&lt;/u&gt; &lt;i&gt;PK&lt;/i&gt;&lt;br&gt;name&lt;br&gt;category_id &lt;i&gt;FK&lt;/i&gt;&lt;br&gt;address&lt;br&gt;lat&lt;br&gt;lon&lt;br&gt;price_level  (1..3)&lt;br&gt;student_discount&lt;br&gt;&lt;i&gt;avg_rating  (derived)&lt;/i&gt;&lt;br&gt;&lt;i&gt;review_count  (derived)&lt;/i&gt;&lt;br&gt;node_id &lt;i&gt;FK&lt;/i&gt;&lt;br&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=8;verticalAlign=top;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="420" y="40" width="250" height="238" as="geometry"/></mxCell><mxCell id="c5" value="&lt;div align='center'&gt;&lt;b&gt;opening_hours&lt;/b&gt;&lt;/div&gt;&lt;hr size='1'&gt;&lt;u&gt;place_id&lt;/u&gt; &lt;i&gt;PK, FK&lt;/i&gt;&lt;br&gt;&lt;u style='text-decoration-style:dashed