// TripGraph relational schema (for dbdiagram.io)
// Table and column names follow the TABLES section of the project description.
// Data types are suggestions only: K's DDL in schema/01_tables.sql is the final authority.

Table app_user {
  user_id int [pk]
  name varchar [not null]
  email varchar [unique, not null]
  role varchar [not null, note: 'student or admin']
  created_at timestamp
}

Table category {
  category_id int [pk]
  name varchar [not null]
  group_name varchar
}

Table node {
  node_id int [pk]
  name varchar [not null]
  kind varchar [note: 'gate, metro, bus stop, e-rickshaw stand, place']
}

Table place {
  place_id int [pk]
  name varchar [not null]
  category_id int [not null]
  address varchar
  lat numeric
  lon numeric
  price_level int [note: 'CHECK 1..3']
  student_discount boolean
  avg_rating numeric [note: 'derived, kept by trigger']
  review_count int [note: 'derived, kept by trigger']
  node_id int
}

Table food_outlet {
  place_id int [pk]
  cuisine varchar
  is_veg boolean
}

Table tag {
  tag_id int [pk]
  name varchar [not null]
}

Table place_tag {
  place_id int
  tag_id int
  indexes {
    (place_id, tag_id) [pk]
  }
}

Table opening_hours {
  place_id int
  day varchar
  open_time time
  close_time time
  indexes {
    (place_id, day) [pk]
  }
}

Table review {
  user_id int
  place_id int
  rating int [note: 'CHECK 1..5']
  review_text text
  created_at timestamp
  indexes {
    (user_id, place_id) [pk]
  }
}

Table edge {
  edge_id int [pk]
  from_node int [not null]
  to_node int [not null]
  mode varchar [note: 'walk, e-rickshaw, auto, metro']
  distance_m int
  time_min int
  fare numeric [note: 'CHECK >= 0']
}

Table trip {
  trip_id int [pk]
  user_id int [not null]
  created_at timestamp
}

Table trip_leg {
  trip_id int
  leg_no int
  edge_id int [not null]
  indexes {
    (trip_id, leg_no) [pk]
  }
}

Table audit_log {
  log_id int [pk]
  action varchar
  table_name varchar
  record_id int
  logged_at timestamp
  Note: 'optional'
}

// Foreign keys
Ref: place.category_id > category.category_id
Ref: place.node_id > node.node_id
Ref: food_outlet.place_id - place.place_id
Ref: place_tag.place_id > place.place_id
Ref: place_tag.tag_id > tag.tag_id
Ref: opening_hours.place_id > place.place_id
Ref: review.user_id > app_user.user_id
Ref: review.place_id > place.place_id
Ref: edge.from_node > node.node_id
Ref: edge.to_node > node.node_id
Ref: trip.user_id > app_user.user_id
Ref: trip_leg.trip_id > trip.trip_id
Ref: trip_leg.edge_id > edge.edge_id

