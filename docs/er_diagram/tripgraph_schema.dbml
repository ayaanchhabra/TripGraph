// TripGraph relational schema (for dbdiagram.io)
// Synced with 01_tables.sql and the final 14-table list. CHECK/UNIQUE/FK rules live in 02_constraints.sql.
// favorite is created in schema/04_favorites.sql; its column types below are suggestions, check against that file.

Table app_user {
  user_id int [pk, increment]
  name text [not null]
  email text [not null, note: 'UNIQUE']
  role text [not null, default: 'student', note: 'student or admin']
  created_at timestamptz [not null, default: `now()`]
}

Table category {
  category_id int [pk, increment]
  name text [not null, note: 'UNIQUE']
  group_name text [not null, note: 'e.g. Food and drink, Essentials']
}

Table node {
  node_id int [pk, increment]
  name text [not null, note: 'UNIQUE']
  kind text [not null, note: 'gate, metro, bus stop, e-rickshaw stand, place']
}

Table edge {
  edge_id int [pk, increment]
  from_node int [not null]
  to_node int [not null]
  mode text [not null]
  distance_m int [not null]
  time_min int [not null]
  fare "numeric(6,2)" [not null, default: 0, note: 'CHECK >= 0']
  Note: 'One direction of travel; two-way roads need two rows'
}

Table place {
  place_id int [pk, increment]
  name text [not null]
  category_id int [not null]
  address text
  lat "numeric(9,6)" [not null]
  lon "numeric(9,6)" [not null]
  price_level smallint [not null, note: 'CHECK 1..3']
  student_discount boolean [not null, default: false]
  avg_rating "numeric(3,2)" [not null, default: 0, note: 'denormalized, trigger-maintained']
  review_count int [not null, default: 0, note: 'denormalized, trigger-maintained']
  node_id int [not null, note: 'map node this place is reached from']
}

Table food_outlet {
  place_id int [pk]
  cuisine text
  is_veg boolean [not null]
  Note: 'Specialization of place'
}

Table tag {
  tag_id int [pk, increment]
  name text [not null, note: 'UNIQUE']
}

Table place_tag {
  place_id int [not null]
  tag_id int [not null]
  indexes {
    (place_id, tag_id) [pk]
  }
}

Table opening_hours {
  place_id int [not null]
  day smallint [not null, note: 'ISO: 1=Mon ... 7=Sun']
  open_time time [not null]
  close_time time [not null, note: 'if < open_time, closes after midnight']
  indexes {
    (place_id, day) [pk]
  }
  Note: 'Weak entity'
}

Table review {
  user_id int [not null]
  place_id int [not null]
  rating smallint [not null, note: 'CHECK 1..5']
  review_text text
  created_at timestamptz [not null, default: `now()`]
  indexes {
    (user_id, place_id) [pk]
  }
}

Table favorite {
  user_id int [not null]
  place_id int [not null]
  visited boolean [note: 'suggested type']
  saved_at timestamptz [note: 'suggested type']
  indexes {
    (user_id, place_id) [pk]
  }
}

Table trip {
  trip_id int [pk, increment]
  user_id int [not null]
  created_at timestamptz [not null, default: `now()`]
}

Table trip_leg {
  trip_id int [not null]
  leg_no smallint [not null]
  edge_id int [not null]
  indexes {
    (trip_id, leg_no) [pk]
  }
  Note: 'Weak entity'
}

Table audit_log {
  log_id int [pk, increment]
  action text [not null]
  table_name text [not null]
  record_id text
  logged_at timestamptz [not null, default: `now()`]
  Note: 'Standalone log table, no foreign keys'
}

// Foreign keys (defined in 02_constraints.sql)
Ref: place.category_id > category.category_id
Ref: place.node_id > node.node_id
Ref: food_outlet.place_id - place.place_id
Ref: place_tag.place_id > place.place_id
Ref: place_tag.tag_id > tag.tag_id
Ref: opening_hours.place_id > place.place_id
Ref: review.user_id > app_user.user_id
Ref: review.place_id > place.place_id
Ref: edge.from_node > node.node_id
Ref: edge.to_node > node.node_id
Ref: favorite.user_id > app_user.user_id
Ref: favorite.place_id > place.place_id
Ref: trip.user_id > app_user.user_id
Ref: trip_leg.trip_id > trip.trip_id
Ref: trip_leg.edge_id > edge.edge_id

